{
  "manifest_version": 3,
  "name": "OpenBridge — ИИ в браузере для Godot",
  "short_name": "OpenBridge",
  "version": "0.2.1",
  "description": "Расширение для DeepSeek, ChatGPT и других веб-ИИ: передаёт задачи и предложенный GDScript в локальный редактор Godot через OpenBridge.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:8767/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OpenBridge — ИИ для Godot",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://deepseek.com/*",
        "https://www.deepseek.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.qwen.ai/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://poe.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}